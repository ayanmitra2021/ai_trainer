# scripts/.env.deploy.example
# ─────────────────────────────────────────────────────────────────────────────
# Template for local deployment credentials.
#
# HOW TO USE:
#   cp scripts/.env.deploy.example scripts/.env.deploy
#   # Edit scripts/.env.deploy and fill in your real values.
#   bash scripts/deploy.sh
#
# scripts/.env.deploy is gitignored — your secrets are never committed.
# This .example file IS committed so teammates know what's needed.
# ─────────────────────────────────────────────────────────────────────────────

# DIRECT Supabase connection (port 5432) — used only by Alembic migrations.
# Must use postgresql+asyncpg:// (the migration runner uses an async engine).
# Use the DIRECT host (db.xxxx.supabase.co:5432), NOT the pgBouncer pooler.
#
# ⚠ Special characters in the password MUST be URL-encoded:
#     %  →  %25      =  →  %3D      ?  →  %3F      &  →  %26      @  →  %40
#
DATABASE_URL_MIGRATE=postgresql+asyncpg://postgres:YOUR_PASSWORD_URL_ENCODED@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Render Deploy Hook URL — triggers a backend rebuild on Render.
# Get it from: Render dashboard → your service → Settings → Deploy Hook.
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-YOURSERVICEID?key=YOURKEY
