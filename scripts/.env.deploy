# scripts/.env.deploy — LOCAL ONLY, gitignored, never commit this file.
# Sourced automatically by scripts/deploy.sh when run locally.
#
# QUOTING RULE: always use single quotes for values that contain shell-special
# characters (& | ; ? = $ ` ! spaces).  Single quotes prevent bash from
# interpreting anything inside them.
#
# URL-ENCODING RULE: special chars in the *password* portion of a database URL
# must also be percent-encoded so the URL parser doesn't misread them:
#   &  →  %26      ?  →  %3F      =  →  %3D      %  →  %25      @  →  %40

# Direct Supabase connection (port 5432) for Alembic migrations.
# Password "NvP5=i?D9X2YF&A" with = → %3D, ? → %3F, & → %26
DATABASE_URL_MIGRATE='postgresql+asyncpg://postgres.rbvrgbzjkxdovoidgmiu:NvP5%3Di%3FD9X2YF%26A@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres'

# Render Deploy Hook URL.
RENDER_DEPLOY_HOOK_URL='https://api.render.com/deploy/srv-d9s6u7v10e5c739be850?key=tzdcBtnhmMU'
