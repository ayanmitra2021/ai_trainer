# ── Prerequisites ────────────────────────────────────────────────────────────
# Postgres 14+ must be installed and running locally on port 5432.
# Create the databases once (as a superuser):
#
#   CREATE USER mastery WITH PASSWORD 'mastery';
#   CREATE DATABASE mastery_pulse OWNER mastery;
#   CREATE DATABASE mastery_pulse_test OWNER mastery;   # for integration tests

# ── Database ────────────────────────────────────────────────────────────────
# Used by the backend app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://mastery:mastery@localhost:5432/mastery_pulse

# Used by Alembic only (synchronous psycopg2 driver).
# Same host/credentials — just a different driver prefix.
ALEMBIC_DATABASE_URL=postgresql+psycopg2://mastery:mastery@localhost:5432/mastery_pulse

# ── Anthropic ────────────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant....

# ── NVIDIA ────────────────────────────────────────────────────────────────
# Get a key at https://integrate.api.nvidia.com/
NVIDIA_API_KEY=nvapi-ftaeu....

# ── Model Provider Selection ────────────────────────────────────────────────
# Set to ANTHROPIC (default) or NVIDIA to choose the LLM provider.
# When NVIDIA is selected, NVIDIA_API_KEY is required.
APP_BRAIN_MODEL=ANTHROPIC
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA model ID on NVIDIA NIM. Default is Nemotron 3 Ultra 550B (free, 40 RPM).
# Run tools/check_nvidia.py to discover all models available on your account.
# Other confirmed-working options (smaller / faster):
#   nvidia/llama-3.3-nemotron-super-49b-v1  ← 49B, also free on standard tier
#   nvidia/nemotron-mini-4b-instruct         ← 4B, fastest but less reliable for structured JSON
# NVIDIA_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b


# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Auth ──────────────────────────────────────────────────────────────────────
# Name of the HTTP-only session cookie sent to browsers.
SESSION_COOKIE_NAME=mastery_session

# Admin/leadership session inactivity timeout in hours.
# Practitioner sessions never expire.
ADMIN_SESSION_TIMEOUT_HOURS=8

# ── Test database ────────────────────────────────────────────────────────────
# Unit tests use in-memory SQLite (no Postgres required).
# Integration tests (@pytest.mark.integration) use this database.
# The pg_engine fixture drops and recreates all tables before the test session.
TEST_DATABASE_URL=postgresql+asyncpg://mastery:mastery@localhost:5432/mastery_pulse_test

# ── Email ─────────────────────────────────────────────────────────────────────
# Email delivery is not implemented. Nudges are in-app only (channel = in_app).
# If you add SMTP support later, set SMTP_HOST / SMTP_PORT / SMTP_FROM / SMTP_USER / SMTP_PASSWORD here.
