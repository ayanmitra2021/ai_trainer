# ── Prerequisites ────────────────────────────────────────────────────────────
# Postgres 14+ must be installed and running locally on port 5432.
# Create the databases once (as a superuser):
#
#   CREATE USER mastery WITH PASSWORD 'mastery';
#   CREATE DATABASE mastery_pulse OWNER mastery;
#   CREATE DATABASE mastery_pulse_test OWNER mastery;   # for integration tests

# ── Database ────────────────────────────────────────────────────────────────
# Used by the backend app (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://mastery:mastery@localhost:5432/mastery_pulse

# Used by Alembic only (synchronous psycopg2 driver).
# Same host/credentials — just a different driver prefix.
ALEMBIC_DATABASE_URL=postgresql+psycopg2://mastery:mastery@localhost:5432/mastery_pulse

# ── Anthropic ────────────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant....
# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Test database ────────────────────────────────────────────────────────────
# Unit tests use in-memory SQLite (no Postgres required).
# Integration tests (@pytest.mark.integration) use this database.
# The pg_engine fixture drops and recreates all tables before the test session.
TEST_DATABASE_URL=postgresql+asyncpg://mastery:mastery@localhost:5432/mastery_pulse_test
